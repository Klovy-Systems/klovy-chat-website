# Klovy Chat website — local development
# Copy: cp .env.example .env.local
# Then: npm install && npm run dev
#
# Optional. Team page loads Discord avatars when set. The site runs without it.
# Generate at: https://discord.com/developers/applications → Bot → Reset Token
# Bot must be on the Klovy Chat Discord server.
DISCORD_BOT_TOKEN=

# Optional. Defaults to the Klovy Chat server ID from the public invite link.
DISCORD_GUILD_ID=925444405383557180
